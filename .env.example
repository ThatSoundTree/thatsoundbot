TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_API_URL=http://localhost:8000
TELEGRAM_BOT_API_PUBLIC_URL=http://localhost:8000

# Ключ для хэширования telegram_id в htelegram_id
# ДОЛЖЕН СОВПАДАТЬ с BACKEND_TELEGRAM_HASH_KEY в thatsoundapi!
TELEGRAM_BOT_TELEGRAM_HASH_KEY=your_telegram_hash_key_here

# Ключ для авторизации в thatsoundapi (отправляется как X-API-Key заголовок)
TELEGRAM_BOT_TO_API_AUTH_KEY=your_to_api_auth_key_here

# Bearer токен для авторизации в thatsounddirect API
# ДОЛЖЕН СОВПАДАТЬ с DDS_AUTH_KEY в thatsounddirect!
TELEGRAM_BOT_DIRECT_API_URL=http://localhost:9999
TELEGRAM_BOT_TO_DIRECT_AUTH_KEY=your_to_direct_auth_key_here

TELEGRAM_BOT_TASK_STATUS_CHECK_INTERVAL=10
TELEGRAM_BOT_TEMP_FILE_CHANNEL=-1001234567890
